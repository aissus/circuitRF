        },
        {
          "Name": "SNR_BPSK_sim",
          "Expression": "-10*log10(mean_over(10^(-(ENVD.SNR_dB[:, :, \u0022Iout\u0022, 1])/10), \u0022rec\u0022))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "SNR_QAM_err",
