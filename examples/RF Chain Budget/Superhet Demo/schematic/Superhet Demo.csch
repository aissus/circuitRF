          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "EVM_QAM_sim",
          "Expression": "sqrt(mean_over((ENVD.EVM_pct[:, :, \u0022Iout\u0022, 0])^2, \u0022rec\u0022))",
