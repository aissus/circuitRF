        },
        {
          "Name": "EVM_BPSK_sim",
          "Expression": "sqrt(mean_over((ENVD.EVM_pct[:, :, \u0022Iout\u0022, 1])^2, \u0022rec\u0022))",
          "Unit": "",
          "ShowOnSchematic": true,
