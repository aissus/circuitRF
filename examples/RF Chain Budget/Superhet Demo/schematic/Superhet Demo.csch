          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "EVMdist_QAM",
          "Expression": "sqrt(mean_over((ENVD.EVMdist_pct[:, :, \u0022Iout\u0022, 0])^2, \u0022rec\u0022))",
